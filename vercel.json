{
  "version": 2,
  "builds": [
    { "src": "index.html",              "use": "@vercel/static" },
    { "src": "dashboard.html",          "use": "@vercel/static" },
    { "src": "eva-app.png",             "use": "@vercel/static" },
    { "src": "api/submit.js",           "use": "@vercel/node" },
    { "src": "api/chat.js",             "use": "@vercel/node" },
    { "src": "api/daily-summary.js",    "use": "@vercel/node" },
    { "src": "api/followup.js",         "use": "@vercel/node" },
    { "src": "api/reactivation.js",     "use": "@vercel/node" },
    { "src": "api/session-recovery.js", "use": "@vercel/node" },
    { "src": "api/calendly-webhook.js", "use": "@vercel/node" },
    { "src": "api/setup-calendly.js",   "use": "@vercel/node" },
    { "src": "api/telegram.js",         "use": "@vercel/node" },
    { "src": "api/abm-bot.js",          "use": "@vercel/node" },
    { "src": "api/abm-notify.js",       "use": "@vercel/node" },
    { "src": "api/lead.js",             "use": "@vercel/node" },
    { "src": "api/primera-reunion.js",  "use": "@vercel/node" },
    { "src": "api/reunion-reminder.js", "use": "@vercel/node" },
    { "src": "api/analytics.js",         "use": "@vercel/node" },
    { "src": "api/ceo-bot.js",          "use": "@vercel/node" },
    { "src": "api/router.js",           "use": "@vercel/node" },
    { "src": "api/fathom-webhook.js",   "use": "@vercel/node" },
    { "src": "api/pandadoc-webhook.js", "use": "@vercel/node" },
    { "src": "api/onboarding.js",         "use": "@vercel/node" },
    { "src": "api/content-reminder.js",  "use": "@vercel/node" },
    { "src": "api/sdr-agent.js",         "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/submit",           "dest": "/api/submit.js" },
    { "src": "/api/chat",             "dest": "/api/chat.js" },
    { "src": "/api/daily-summary",    "dest": "/api/daily-summary.js" },
    { "src": "/api/followup",         "dest": "/api/followup.js" },
    { "src": "/api/reactivation",     "dest": "/api/reactivation.js" },
    { "src": "/api/session-recovery", "dest": "/api/session-recovery.js" },
    { "src": "/api/calendly-webhook", "dest": "/api/calendly-webhook.js" },
    { "src": "/api/setup-calendly",   "dest": "/api/setup-calendly.js" },
    { "src": "/api/telegram",         "dest": "/api/telegram.js" },
    { "src": "/api/abm-bot",          "dest": "/api/abm-bot.js" },
    { "src": "/api/lead",             "dest": "/api/lead.js" },
    { "src": "/api/primera-reunion",  "dest": "/api/primera-reunion.js" },
    { "src": "/api/reunion-reminder", "dest": "/api/reunion-reminder.js" },
    { "src": "/api/analytics",         "dest": "/api/analytics.js" },
    { "src": "/api/ceo-bot",          "dest": "/api/ceo-bot.js" },
    { "src": "/api/router",           "dest": "/api/router.js" },
    { "src": "/api/fathom-webhook",   "dest": "/api/fathom-webhook.js" },
    { "src": "/api/pandadoc-webhook", "dest": "/api/pandadoc-webhook.js" },
    { "src": "/api/onboarding",          "dest": "/api/onboarding.js" },
    { "src": "/api/content-reminder",   "dest": "/api/content-reminder.js" },
    { "src": "/api/sdr-agent",          "dest": "/api/sdr-agent.js" },
    { "src": "/dashboard",            "dest": "/dashboard.html" },
    { "src": "/eva-app.png",          "dest": "/eva-app.png" },
    { "src": "/(.*)",                 "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/daily-summary",    "schedule": "0 13 * * *"  },
    { "path": "/api/followup",         "schedule": "0 14 * * *"  },
    { "path": "/api/reactivation",     "schedule": "0 14 * * 1"  },
    { "path": "/api/session-recovery", "schedule": "0 */4 * * *" },
    { "path": "/api/reunion-reminder", "schedule": "0 * * * *"   },
    { "path": "/api/onboarding",        "schedule": "0 15 * * *"  },
    { "path": "/api/content-reminder", "schedule": "0 12 * * 1-5" }
  ]
}
