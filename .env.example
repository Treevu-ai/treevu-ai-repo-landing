# ── Telegram ──────────────────────────────────────────────────────────────────
# Token del bot interno ABM (@treev_abm_bot)
TELEGRAM_BOT_TOKEN=

# Token del bot público (@treevubot) — para notificar prospectos
TELEGRAM_VU_BOT_TOKEN=

# Chat ID personal (positivo) — usado por api/daily-summary.js
TELEGRAM_CHAT_ID=

# Chat ID del grupo ABM "🤖 Treevü ABM Notificaciones" (negativo, ej: -1001234567890)
# Obtener con: node scripts/get-chat-id.js  (después de invitar el bot al grupo)
TELEGRAM_ABM_CHAT_ID=

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_TOKEN=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Gmail ─────────────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=hello@gettreevu.com

# ── Upstash Redis (sesiones del bot público @treevubot) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Webhooks / Calendly ───────────────────────────────────────────────────────
LEAD_WEBHOOK_SECRET=
CALENDLY_TOKEN=
